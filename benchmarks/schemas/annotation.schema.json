{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://berrybrain.local/schemas/annotation.schema.json",
  "title": "BerryBrain Blinded Annotation",
  "type": "object",
  "required": ["caseId", "annotatorId", "label", "abstained", "createdAt"],
  "properties": {
    "caseId": { "type": "string", "minLength": 1 },
    "annotatorId": { "type": "string", "minLength": 1 },
    "label": { "type": ["string", "number", "boolean", "null"] },
    "abstained": { "type": "boolean" },
    "rationale": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
