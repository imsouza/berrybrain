{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://berrybrain.local/schemas/dataset-manifest.schema.json",
  "title": "BerryBrain dataset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "source", "license", "version", "files"],
  "properties": {
    "schemaVersion": {"const": "berrybrain-dataset.v1"},
    "id": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "license": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "citation": {"type": "string"},
    "acquisition": {"type": "string"},
    "status": {"enum": ["not-installed", "installed", "verified"]},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "split": {"type": "string"},
          "sourceUrl": {"type": "string"}
        }
      }
    }
  }
}
